OPENAI_API_KEY=

# Use "openai" for direct API calls, or "codex" to delegate to Codex CLI
# authenticated with Sign in with ChatGPT.
SCRATCH_AI_BACKEND=openai

# Default model for normal and web modes.
SCRATCH_AI_MODEL=gpt-5.4-mini

# Model for deeper reasoning modes.
SCRATCH_AI_THINK_MODEL=gpt-5.4-mini

# Command used for the Codex CLI backend.
SCRATCH_AI_CODEX_COMMAND=codex

# Abort Codex backend requests after this many milliseconds.
SCRATCH_AI_CODEX_TIMEOUT_MS=120000

# Optional Codex OAuth web-search bridge settings.
SCRATCH_AI_CODEX_SEARCH_MODEL=
SCRATCH_AI_CODEX_SEARCH_BASE_URL=https://chatgpt.com/backend-api
SCRATCH_AI_CODEX_SEARCH_CONTEXT_SIZE=medium

# Where JSONL logs should be written.
SCRATCH_AI_LOG_DIR=~/dev-brain/inbox

# Optional SQLite FTS index path for scratch-logs.
# Defaults to ~/dev-brain/scratch-ai.sqlite when SCRATCH_AI_LOG_DIR is ~/dev-brain/inbox.
SCRATCH_AI_INDEX_PATH=~/dev-brain/scratch-ai.sqlite

# Optional project label added to logs.
SCRATCH_AI_PROJECT=general

# Optional user timezone label.
SCRATCH_AI_TIMEZONE=Europe/Rome
