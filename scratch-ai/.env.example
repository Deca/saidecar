OPENAI_API_KEY=

# Use "openai" for direct API calls, or "codex" to delegate to Codex CLI
# authenticated with Sign in with ChatGPT.
# Both SAIDECAR_BACKEND and SCRATCH_AI_BACKEND are accepted (new name preferred).
SAIDECAR_BACKEND=openai

# Default model for normal and web modes.
SAIDECAR_MODEL=gpt-5.4-mini

# Model for deeper reasoning modes.
SAIDECAR_THINK_MODEL=gpt-5.4-mini

# Command used for the Codex CLI backend.
SAIDECAR_CODEX_COMMAND=codex

# Abort Codex backend requests after this many milliseconds.
SAIDECAR_CODEX_TIMEOUT_MS=120000

# Codex login status is re-verified at most every 10 minutes. The first
# `codex login status` check in a session still runs; subsequent questions
# skip the redundant subprocess until the TTL expires.

# Optional Codex OAuth web-search bridge settings.
SAIDECAR_CODEX_SEARCH_MODEL=
SAIDECAR_CODEX_SEARCH_BASE_URL=https://chatgpt.com/backend-api
SAIDECAR_CODEX_SEARCH_CONTEXT_SIZE=medium

#Minimax settings
SAIDECAR_PROVIDER=
MINIMAX_SUBSCRIPTION_KEY=
MINIMAX_API_KEY=
SAIDECAR_MODEL=
# Optional authentication mode for Minimax provider (e.g., "api_key" or "OAuth").
MINIMAX_AUTH_MODE=


# Where JSONL logs should be written.
#
# Resolution order (first match wins):
#   1. SAIDECAR_LOG_DIR (preferred new name)
#   2. SCRATCH_AI_LOG_DIR (legacy alias)
#   3. ~/dev-brain/inbox if it exists from a prior install (no data loss)
#   4. ~/.saidecar/logs (new default)
#
# The SQLite index, annotations, and sessions directories are derived from
# the same parent directory. Legacy indexes keep their `scratch-ai.sqlite`
# filename; new indexes use `saidecar.sqlite`.
#SAIDECAR_LOG_DIR=~/.saidecar/logs

# Optional SQLite FTS index path for saidecar-logs.
# Defaults to <log-dir-parent>/saidecar.sqlite on new installs, or
# <log-dir-parent>/scratch-ai.sqlite when reusing ~/dev-brain/inbox.
#SAIDECAR_INDEX_PATH=

# Optional append-only annotations for saved/favorited/tagged entries.
# Defaults to <log-dir-parent>/annotations.
#SAIDECAR_ANNOTATION_DIR=

# Optional Markdown reviews generated by saidecar-digest --write.
# Defaults to <log-dir-parent>/sessions.
#SAIDECAR_SESSION_DIR=

# Optional project label added to logs.
SAIDECAR_PROJECT=general

# Optional user timezone label.
SAIDECAR_TIMEZONE=Europe/Rome

# Thinking display (for models like MiniMax-M3 that output thinking)
SAIDECAR_SHOW_THINKING=false    # true to show thinking blocks, false to hide (default: false)


# Optional: enable LLM-generated narrative summary for the weekly digest
# (off by default; the digest body is always rule-based and deterministic).
SAIDECAR_WEEKLY_SUMMARY=false

# Optional: when true, the digest command checks the most recent weekly
# report on startup and prompts to generate a new one if it is older than
# 7 days. Skip the prompt for one run with --no-weekly-check, or auto-accept
# with --yes.
SAIDECAR_WEEKLY_AUTO=false

# Backward-compat aliases (still honored, kept for existing setups).
# If both SAIDECAR_* and SCRATCH_AI_* are set, the SAIDECAR_* value wins.
#SCRATCH_AI_BACKEND=openai
#SCRATCH_AI_MODEL=gpt-5.4-mini
#SCRATCH_AI_LOG_DIR=~/dev-brain/inbox
