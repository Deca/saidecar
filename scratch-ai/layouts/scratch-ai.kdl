layout {
    tab name="scratch-ai" {
        pane split_direction="vertical" {
            pane {
                cwd "."
                command "C:\\Program Files\\nodejs\\node.exe"
                args "bin\\scratch-ai.js"
            }
            pane size="42%" {
                cwd "."
                command "C:\\Program Files\\nodejs\\node.exe"
                args "bin\\scratch-logs.js"
            }
        }
    }
}
